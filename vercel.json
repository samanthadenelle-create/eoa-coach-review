{
  "git": { "deploymentEnabled": false },
  "outputDirectory": "Builds/WebGL",
  "buildCommand": null,
  "framework": null,
  "crons": [
    { "path": "/api/admin/cleanup", "schedule": "0 4 * * *" },
    { "path": "/api/admin/google-play-voided-reconcile", "schedule": "30 4 * * *" }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/.well-known/assetlinks.json", "destination": "/api/assetlinks" },
    { "source": "/icon.png", "destination": "/api/icon" }
  ],
  "headers": [
    {
      "source": "/Build/:file(.*\\.unityweb)",
      "headers": [{ "key": "Content-Encoding", "value": "br" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ]
}
